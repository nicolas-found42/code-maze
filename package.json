{
  "name": "code-maze",
  "version": "0.1.0",
  "private": true,
  "description": "A standalone bead maze codebase map and photographic companion.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "start": "node scripts/server.mjs",
    "scan": "node scripts/scan.mjs",
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/server.mjs --directory dist",
    "test:ui": "node scripts/ui-review.mjs",
    "assets:3d": "node scripts/bake-bead.mjs && node scripts/vendor-3d.mjs",
    "bake:plywood": "node scripts/bake-plywood.mjs",
    "test:fidelity": "node scripts/fidelity-review.mjs",
    "test:studio": "node scripts/studio-review.mjs",
    "test:photographic": "node scripts/photographic-review.mjs",
    "test:contact": "node scripts/contact-review.mjs",
    "test:contact-ui": "node scripts/contact-browser-review.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "canvas-confetti": "1.9.4",
    "ignore": "^7.0.14",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "esbuild": "0.25.12",
    "n8ao": "2.0.1",
    "oidn-webgpu": "0.6.0",
    "playwright": "^1.64.1",
    "postprocessing": "6.35.3",
    "three": "0.160.0",
    "three-bvh-csg": "0.0.16",
    "three-gpu-pathtracer": "0.0.23",
    "three-mesh-bvh": "0.8.3",
    "xatlas-web": "0.1.0"
  }
}
